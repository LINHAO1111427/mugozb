# Local Docker Compose overrides for docker-compose.sub2api.yml
SUB2API_HTTP_PROXY=http://host.docker.internal:7890
SUB2API_HTTPS_PROXY=http://host.docker.internal:7890
SUB2API_ALL_PROXY=socks5://host.docker.internal:7890
SUB2API_NO_PROXY=127.0.0.1,localhost,::1,postgres,redis,sub2api,host.docker.internal

# OpenAI Responses gateway tuning
GATEWAY_FORCE_CODEX_CLI=false
GATEWAY_OPENAI_COMPACT_MODEL=gpt-5.4
SUB2API_IMAGES_MAIN_MODEL=gpt-5.6-luna
GATEWAY_OPENAI_RESPONSE_HEADER_TIMEOUT=0
GATEWAY_OPENAI_WS_FORCE_HTTP=true
GATEWAY_OPENAI_HTTP2_ENABLED=true
GATEWAY_OPENAI_HTTP2_ALLOW_PROXY_FALLBACK_TO_HTTP1=true
GATEWAY_OPENAI_HTTP2_FALLBACK_ERROR_THRESHOLD=2
GATEWAY_OPENAI_HTTP2_FALLBACK_WINDOW_SECONDS=60
GATEWAY_OPENAI_HTTP2_FALLBACK_TTL_SECONDS=600
GATEWAY_OPENAI_PROXY_STREAM_CIRCUIT_FAILURE_THRESHOLD=2
GATEWAY_OPENAI_PROXY_STREAM_CIRCUIT_WINDOW_SECONDS=60
GATEWAY_OPENAI_PROXY_STREAM_CIRCUIT_TTL_SECONDS=600
SUB2API_DATABASE_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
JWT_SECRET=generate-a-long-random-secret
TOTP_ENCRYPTION_KEY=generate-a-64-character-hex-key

# Required when enabling the corresponding Google OAuth integration.
# Supply the matching client ID/secret pair through the private .env file.
GEMINI_CLI_OAUTH_CLIENT_ID=
GEMINI_CLI_OAUTH_CLIENT_SECRET=
ANTIGRAVITY_OAUTH_CLIENT_ID=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=
