# Local Docker Compose overrides for docker-compose.sub2api.yml
SUB2API_HTTP_PROXY=http://host.docker.internal:7890
SUB2API_HTTPS_PROXY=http://host.docker.internal:7890
SUB2API_ALL_PROXY=socks5://host.docker.internal:7890
SUB2API_NO_PROXY=127.0.0.1,localhost,::1,postgres,redis,sub2api,host.docker.internal
SUB2API_DATABASE_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
JWT_SECRET=generate-a-long-random-secret
TOTP_ENCRYPTION_KEY=generate-a-64-character-hex-key
